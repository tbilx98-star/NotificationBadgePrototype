<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="iOS Badge"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_permission_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Grant Notification Access"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_permission_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Grant Overlay Permission"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_select_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Select Apps to Badge"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_calibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Calibrate Badge Position"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_toggle_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Badge Service"
        android:backgroundTint="#007AFF" />

</LinearLayout>
